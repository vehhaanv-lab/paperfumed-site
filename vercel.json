{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://*.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://formsubmit.co https://vercel.live https://*.vercel-insights.com; img-src 'self' data:; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.paperfumed.vercel.app"
        }
      ],
      "destination": "https://paperfumed.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/concept.html",
      "destination": "/concept",
      "permanent": true
    },
    {
      "source": "/science.html",
      "destination": "/science",
      "permanent": true
    },
    {
      "source": "/questions.html",
      "destination": "/questions",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/contact.html",
      "status": 308,
      "headers": {
        "Location": "/#contact"
      }
    },
    {
      "src": "/index.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/concept.html",
      "status": 308,
      "headers": {
        "Location": "/concept"
      }
    },
    {
      "src": "/science.html",
      "status": 308,
      "headers": {
        "Location": "/science"
      }
    },
    {
      "src": "/questions.html",
      "status": 308,
      "headers": {
        "Location": "/questions"
      }
    },
    {
      "src": "/privacy.html",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/concept",
      "dest": "/concept.html"
    },
    {
      "src": "/science",
      "dest": "/science.html"
    },
    {
      "src": "/questions",
      "dest": "/questions.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
