{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://*.vercel-insights.com https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://formsubmit.co https://vercel.live https://*.vercel-insights.com https://www.google-analytics.com https://region1.google-analytics.com https://challenges.cloudflare.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com https://vercel.live;"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.paperfumed.vercel.app"
        }
      ],
      "destination": "https://paperfumed.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/og-image-v4.jpg",
      "destination": "/api/og-card"
    },
    {
      "source": "/assets/island-img-640.webp",
      "destination": "/api/ri-island-img"
    },
    {
      "source": "/assets/island-bottle-800.webp",
      "destination": "/api/ri-island-bottle"
    },
    {
      "source": "/assets/island-bloomed-800.webp",
      "destination": "/api/ri-island-bloomed"
    },
    {
      "source": "/assets/island-fraying-800.webp",
      "destination": "/api/ri-island-fraying"
    },
    {
      "source": "/og-image.png",
      "destination": "/api/og-card"
    }
  ]
}
